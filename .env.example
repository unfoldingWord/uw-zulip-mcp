# ZulipChat MCP local development environment

# Preferred for local testing when you do not want to keep absolute paths in client
# config. Leave these unset if you prefer passing `--zulip-config-file` explicitly.
ZULIP_EMAIL=
ZULIP_API_KEY=
ZULIP_SITE=

# Optional bot identity for agent/session messaging.
ZULIP_BOT_EMAIL=
ZULIP_BOT_API_KEY=

# Optional config-file overrides.
ZULIP_CONFIG_FILE=
ZULIP_BOT_CONFIG_FILE=

# Optional runtime flags.
ZULIPCHAT_EXTENDED_TOOLS=0
MCP_DEBUG=false
MCP_PORT=3000
ZULIPCHAT_AGENT_STREAM=
ZULIPCHAT_APPROVAL_TIMEOUT=900
